<div class="modal fade" id="aptrust_modal" tabindex="-1" role="dialog" aria-labelledby="aptrustModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="aptrustModalLabel">AP Trust Preservation</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= render 'aptrust_submissions/collection_status', collection: collection %>
    </div>
  </div>
</div>
<script>
  // reopen the modal after a submission redirects back to #aptrust
  document.addEventListener('DOMContentLoaded', function () {
    if (window.location.hash !== '#aptrust') return;
    bootstrap.Modal.getOrCreateInstance(document.getElementById('aptrust_modal')).show();
    history.replaceState(null, '', window.location.pathname + window.location.search);
  });
</script>
